# Normalize line endings — LF in the repo, checked out native on Windows.
* text=auto eol=lf

# Windows-specific scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts always LF
*.sh   text eol=lf

# Explicit text types
*.ts   text
*.tsx  text
*.js   text
*.jsx  text
*.mjs  text
*.cjs  text
*.json text
*.md   text
*.yml  text
*.yaml text
*.html text
*.css  text
*.scss text

# Binary assets — never diff or normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.mp4  binary
*.webm binary

# Lockfiles: mark generated so GitHub collapses diffs
pnpm-lock.yaml    linguist-generated=true -diff
