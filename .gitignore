# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.local

# Vite
.vite/
vite.config.*.timestamp-*

# ---------------------------------------------------------------------------
# Environment & secrets  (never commit these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
.secrets/

# ---------------------------------------------------------------------------
# Testing / coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
.vitest/
playwright-report/
test-results/

# ---------------------------------------------------------------------------
# Performance tooling
# ---------------------------------------------------------------------------
.lighthouseci/
lighthouse-report.*
stats.html
bundle-stats.*

# ---------------------------------------------------------------------------
# Logs & caches
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.cache/
.turbo/
tsconfig.tsbuildinfo
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.suo
*~

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Local tooling
# ---------------------------------------------------------------------------
# Editor and assistant configuration belongs to one machine, not the project.
.claude/
dev.log

# Written by `rustypipe` at runtime beside the crate — YouTube's player
# configuration, cached so a launch does not re-fetch it. Regenerated on
# demand, machine-specific, and it appears the first time anyone runs the app.
src-tauri/rustypipe_cache.json

# The yt-dlp sidecar, fetched per machine by `pnpm extractor` against a pinned
# checksum. Seventeen megabytes of someone else's binary is a download, not a
# source file; tauri.conf.json's `externalBin` expects it here.
src-tauri/binaries/
