# Example environment variables. Copy to .env.local and fill in.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put secrets in VITE_-prefixed variables — they ship to the browser.

# VITE_API_BASE_URL=https://api.example.com

# Clerk authentication.
#
# Only the PUBLISHABLE key belongs here. It is designed to ship in the client
# bundle. The secret key (sk_...) must never appear in this repo or in any
# VITE_-prefixed variable — anything with that prefix is compiled into the
# bundle and is readable by every user of the app.
#
# Without this key the app still runs; you lose cross-device sync, nothing else.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
